# Netlify Functions (server-side only — set in Netlify dashboard for prod)
CAREER_SHEET_URL=https://script.google.com/macros/s/PLACEHOLDER/exec
CAREER_SHEET_API_KEY=PLACEHOLDER

# Atlas + Compass (Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=PLACEHOLDER

# Frontend build (VITE_ prefix = bundled into the client, safe to expose —
# these are Supabase's public anon key, not a secret)
VITE_SUPABASE_URL=https://PLACEHOLDER.supabase.co
VITE_SUPABASE_ANON_KEY=PLACEHOLDER

# Analytics (src/lib/analytics.js). Optional in dev — if either is unset,
# initAnalytics() no-ops instead of erroring, so local testing never sends
# events anywhere. Get these from your PostHog project settings.
VITE_POSTHOG_KEY=PLACEHOLDER
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Admin login — server-side check in netlify/functions/admin-login.mjs.
# Pick any email/password you want; there's no real account behind these,
# just an env var comparison.
ADMIN_EMAIL=PLACEHOLDER
ADMIN_PASSWORD=PLACEHOLDER
# Signs the admin session token (netlify/functions/lib/adminAuth.mjs) —
# any long random string, unrelated to ADMIN_PASSWORD. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=PLACEHOLDER

# Service role key — Netlify Functions only, NEVER add a VITE_ prefix to
# this (that would bundle it into the browser). Bypasses RLS entirely, so
# only admin-practitioners.mjs / admin-testimonials.mjs use it, gated by
# ADMIN_TOKEN_SECRET first. Get it from Supabase dashboard -> Project
# Settings -> API -> service_role key (NOT the anon key above).
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER

# "Sync from Sheet" button in /admin (sync-practitioners.mjs /
# sync-testimonials.mjs) — a Google Sheet tab published to web as CSV:
# in Google Sheets, File -> Share -> Publish to web -> pick the tab ->
# CSV -> Publish, then copy the URL it gives you. Optional: leave unset
# if you'd rather add practitioners/testimonials one at a time in the UI.
PRACTITIONERS_SHEET_CSV_URL=PLACEHOLDER
TESTIMONIALS_SHEET_CSV_URL=PLACEHOLDER
